{
  "version": 1,
  "defaults": {},
  "pre": [
    {
      "id": "dangerous-commands",
      "tool": "Bash",
      "description": "Block destructive commands",
      "pipeline": [
        { "stage": "command-contains", "args": ["dd if=", "mkfs.", "chmod 777", "shutdown", "reboot"] },
        { "stage": "deny", "message": "Blocked: destructive command" }
      ]
    },
    {
      "id": "rm-ask",
      "tool": "Bash",
      "description": "Ask before any rm command",
      "pipeline": [
        { "stage": "command-prefix", "args": ["rm "] },
        { "stage": "ask" }
      ]
    },
    {
      "id": "git-commit-ask",
      "tool": "Bash",
      "description": "Always ask before committing",
      "pipeline": [
        { "stage": "command-contains", "args": ["git commit"] },
        { "stage": "ask" }
      ]
    },
    {
      "id": "block-secret-cli",
      "tool": "Bash",
      "description": "Block direct secret retrieval commands",
      "pipeline": [
        { "stage": "command-prefix", "args": ["vault kv get ", "vault read ", "vault kv show ", "gcloud secrets versions access "] },
        { "stage": "deny", "message": "Direct secret retrieval is blocked. Use {{vault:mount@path:field}} or {{gcp:project/secret}} templates instead." }
      ]
    },
    {
      "id": "template-leak-guard",
      "tool": "Bash",
      "description": "Block commands that would print secret values to stdout",
      "pipeline": [
        { "stage": "has-template" },
        { "stage": "template-leaks-value", "prefixes": ["curl ", "wget ", "ansible-playbook ", "ansible ", "kubectl ", "docker ", "helm ", "ssh ", "scp ", "rsync ", "git ", "glab ", "mysql ", "psql ", "redis-cli ", "openssl "] },
        { "stage": "deny", "message": "Secret templates must not be echoed to stdout. Use them as arguments to commands (e.g. curl -H 'Authorization: {{vault:...}}')." }
      ]
    },
    {
      "id": "template-rewrite",
      "tool": "Bash",
      "description": "Wrap template-bearing commands in exec",
      "pipeline": [
        { "stage": "has-template" },
        { "stage": "rewrite-exec" }
      ]
    },
    {
      "id": "block-direct-exec",
      "tool": "Bash",
      "description": "Prevent direct claude-hook-engine exec calls",
      "pipeline": [
        { "stage": "command-prefix", "args": ["claude-hook-engine exec"] },
        { "stage": "deny", "message": "Use template syntax {{vault:...}} instead of calling exec directly" }
      ]
    },
    {
      "id": "block-cat-no-pipe",
      "tool": "Bash",
      "description": "Redirect cat to Read tool when not piped",
      "pipeline": [
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-prefix", "args": ["cat "] },
        { "stage": "redirect", "message": "Use the Read tool instead of cat", "tool": "Read" }
      ]
    },
    {
      "id": "block-grep-no-pipe",
      "tool": "Bash",
      "description": "Redirect grep/rg to Grep tool when not piped",
      "pipeline": [
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-prefix", "args": ["grep ", "rg "] },
        { "stage": "redirect", "message": "Use the Grep tool instead", "tool": "Grep" }
      ]
    },
    {
      "id": "block-find-no-pipe",
      "tool": "Bash",
      "description": "Redirect find to Glob tool when not piped",
      "pipeline": [
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-prefix", "args": ["find "] },
        { "stage": "redirect", "message": "Use the Glob tool instead of find", "tool": "Glob" }
      ]
    },
    {
      "id": "kubectl-unfiltered",
      "tool": "Bash",
      "description": "Require filtered output for kubectl get/describe",
      "pipeline": [
        { "stage": "command-prefix", "args": ["kubectl get", "kubectl describe"] },
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-contains", "args": ["-o json", "-o yaml", "-o name", "-o wide"], "negate": true },
        { "stage": "deny", "message": "Use -o json | jq or pipe output to filter kubectl results" }
      ]
    },
    {
      "id": "kubectl-logs-unbounded",
      "tool": "Bash",
      "description": "Require --tail or --since for kubectl logs",
      "pipeline": [
        { "stage": "command-prefix", "args": ["kubectl logs"] },
        { "stage": "command-contains", "args": ["--tail", "--since"], "negate": true },
        { "stage": "deny", "message": "Use --tail or --since to bound kubectl logs" }
      ]
    },
    {
      "id": "unbounded-git-log",
      "tool": "Bash",
      "description": "Catch unbounded git log/diff",
      "pipeline": [
        { "stage": "command-prefix", "args": ["git log", "git diff"] },
        { "stage": "detect-intent" },
        { "stage": "redirect-if", "condition": "intent=unbounded", "message": "Use ctx_execute for large git output" }
      ]
    },
    {
      "id": "subshell-allow",
      "tool": "Bash",
      "description": "Allow subshells when all parts are permitted",
      "pipeline": [
        { "stage": "has-subshell" },
        { "stage": "all-parts-allowed", "prefixes": ["cd ", "skill ", "curl ", "git ", "kubectl ", "docker ", "jq ", "yq ", "cat ", "head ", "tail ", "grep ", "find ", "ls ", "tree ", "mkdir ", "cp ", "xargs ", "go ", "npm ", "python ", "ruff ", "golangci-lint ", "gcloud ", "ansible ", "a11s ", "./bin/a11s ", "hilo ", "mcpl ", "claude-hook-engine ", "echo ", "bun ", "semgrep "] }
      ]
    }
  ],
  "post": []
}
