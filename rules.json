{
  "version": 1,
  "defaults": {},
  "pre": [
    {
      "id": "destructive-verbs",
      "tool": "Bash",
      "description": "Block destructive command verbs (AST-aware, ignores quoted text)",
      "pipeline": [
        { "stage": "has-command", "args": ["shutdown", "reboot", "mkfs."] },
        { "stage": "deny", "message": "Blocked: destructive command" }
      ]
    },
    {
      "id": "dangerous-flag-patterns",
      "tool": "Bash",
      "description": "Block dangerous argument patterns",
      "pipeline": [
        { "stage": "command-contains", "args": ["dd if=", "chmod 777"] },
        { "stage": "deny", "message": "Blocked: destructive command" }
      ]
    },
    {
      "id": "rm-ask",
      "tool": "Bash",
      "description": "Ask before any rm command",
      "pipeline": [
        { "stage": "command-prefix", "args": ["rm "] },
        { "stage": "ask" }
      ]
    },
    {
      "id": "git-commit-ask",
      "tool": "Bash",
      "description": "Always ask before committing",
      "pipeline": [
        { "stage": "command-contains", "args": ["git commit"] },
        { "stage": "ask" }
      ]
    },
    {
      "id": "block-secret-cli",
      "tool": "Bash",
      "description": "Block direct secret retrieval commands",
      "pipeline": [
        { "stage": "command-prefix", "args": ["vault kv get ", "vault read ", "vault kv show ", "gcloud secrets versions access ", "secretctl get ", "skill secrets get ", "skill secrets show ", "ansible-vault view ", "gh secret list ", "op read ", "op item get ", "pass show "] },
        { "stage": "deny", "message": "Direct secret retrieval is blocked. Use {{vault:mount@path:field}} or {{gcp:project/secret}} templates instead." }
      ]
    },
    {
      "id": "template-block-leaky",
      "tool": "Bash",
      "description": "Block secret templates given to commands that print args/stdin or run inline code (regex; blocklist wins, evaluated before the allow-guard)",
      "pipeline": [
        { "stage": "has-template" },
        { "stage": "command-regex", "patterns": [
          "(^|/)(echo|printf)(\\s|$)",
          "(^|/)cat(\\s|$)",
          "(^|/)tee(\\s|$)",
          "(^|/)(printenv|env|set|export)(\\s|$)",
          "(^|/)(head|tail|less|more|xxd|hexdump|strings|od|base64)(\\s|$)",
          "(^|/)python3?\\s+(-\\S+\\s+)*-c(\\s|$)",
          "(^|/)(node|deno|bun)\\s+(-\\S+\\s+)*-e(\\s|$)",
          "(^|/)(ruby|perl|php)\\s+(-\\S+\\s+)*-e(\\s|$)",
          "(^|/)(sh|bash|zsh|dash|fish|ksh)\\s+(-\\S+\\s+)*-c(\\s|$)",
          "(^|/)eval(\\s|$)"
        ] },
        { "stage": "deny", "message": "This command would expose secret values (it prints args/stdin or runs inline code). Pass secrets only as arguments to a consumer command (e.g. curl -H 'Authorization: {{vault:...}}'), or to a script file (python script.py {{vault:...}}) — not via -c/-e or echo/cat." }
      ]
    },
    {
      "id": "template-require-allowed-consumer",
      "tool": "Bash",
      "description": "Deny secret templates for any command not on the allowed-consumer list (regex; default-deny). Blocklist above takes precedence.",
      "pipeline": [
        { "stage": "has-template" },
        { "stage": "command-regex", "negate": true, "patterns": [
          "(^|/)(curl|wget)(\\s|$)",
          "(^|/)(kubectl|helm)(\\s|$)",
          "(^|/)(ansible|ansible-playbook|ansible-vault)(\\s|$)",
          "(^|/)(docker|podman)(\\s|$)",
          "(^|/)(sshpass|scp|rsync)(\\s|$)",
          "(^|/)(psql|mysql|mongosh|redis-cli)(\\s|$)",
          "(^|/)(openssl|htpasswd)(\\s|$)",
          "(^|/)(aws|gcloud|az)(\\s|$)",
          "(^|/)(terraform|tofu|vault|consul)(\\s|$)",
          "(^|/)(gh|glab|git)(\\s|$)",
          "(^|/)(npm|pip|go|cargo)(\\s|$)",
          "(^|/)python3?(\\s|$)",
          "(^|/)(node|deno|bun|ruby|perl|php)(\\s|$)",
          "(^|/)secretctl\\s+exec(\\s|$)"
        ] },
        { "stage": "deny", "message": "Command is not an allowed secret consumer. Only known consumers (curl, kubectl, ssh, git, aws, python <script>, ...) may receive secret templates; everything else is denied by default. Add a pattern to template-require-allowed-consumer if this command is safe." }
      ]
    },
    {
      "id": "template-rewrite",
      "tool": "Bash",
      "description": "Wrap template-bearing commands in exec",
      "pipeline": [
        { "stage": "has-template" },
        { "stage": "rewrite-exec" }
      ]
    },
    {
      "id": "block-direct-exec",
      "tool": "Bash",
      "description": "Prevent direct claude-hook-engine exec calls",
      "pipeline": [
        { "stage": "command-prefix", "args": ["claude-hook-engine exec"] },
        { "stage": "deny", "message": "Use template syntax {{vault:...}} instead of calling exec directly" }
      ]
    },
    {
      "id": "block-cat-no-pipe",
      "tool": "Bash",
      "description": "Redirect cat to Read tool when not piped",
      "pipeline": [
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-prefix", "args": ["cat "] },
        { "stage": "redirect", "message": "Use the Read tool instead of cat", "tool": "Read" }
      ]
    },
    {
      "id": "block-grep-no-pipe",
      "tool": "Bash",
      "description": "Redirect grep/rg to Grep tool when not piped",
      "pipeline": [
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-prefix", "args": ["grep ", "rg "] },
        { "stage": "redirect", "message": "Use the Grep tool instead", "tool": "Grep" }
      ]
    },
    {
      "id": "block-find-no-pipe",
      "tool": "Bash",
      "description": "Redirect find to Glob tool when not piped",
      "pipeline": [
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-prefix", "args": ["find "] },
        { "stage": "redirect", "message": "Use the Glob tool instead of find", "tool": "Glob" }
      ]
    },
    {
      "id": "kubectl-unfiltered",
      "tool": "Bash",
      "description": "Require filtered output for kubectl get/describe",
      "pipeline": [
        { "stage": "command-prefix", "args": ["kubectl get", "kubectl describe"] },
        { "stage": "has-pipe", "negate": true },
        { "stage": "command-contains", "args": ["-o json", "-o yaml", "-o name", "-o wide"], "negate": true },
        { "stage": "deny", "message": "Use -o json | jq or pipe output to filter kubectl results" }
      ]
    },
    {
      "id": "kubectl-logs-unbounded",
      "tool": "Bash",
      "description": "Require --tail or --since for kubectl logs",
      "pipeline": [
        { "stage": "command-prefix", "args": ["kubectl logs"] },
        { "stage": "command-contains", "args": ["--tail", "--since"], "negate": true },
        { "stage": "deny", "message": "Use --tail or --since to bound kubectl logs" }
      ]
    },
    {
      "id": "unbounded-git-log",
      "tool": "Bash",
      "description": "Catch unbounded git log/diff",
      "pipeline": [
        { "stage": "command-prefix", "args": ["git log", "git diff"] },
        { "stage": "detect-intent" },
        { "stage": "redirect-if", "condition": "intent=unbounded", "message": "Use ctx_execute for large git output" }
      ]
    },
    {
      "id": "ssh-block-dangerous-opts",
      "tool": "Bash",
      "description": "Block ssh/scp -o options that execute arbitrary code (ProxyCommand/LocalCommand/PermitLocalCommand). Denylist — the only -o options that run code.",
      "pipeline": [
        { "stage": "command-regex", "patterns": ["(^|[\\s;&|])(ssh|scp|sshpass)(\\s|$)"] },
        { "stage": "command-regex", "patterns": ["(?i)(proxycommand|localcommand)"] },
        { "stage": "deny", "message": "ssh -o ProxyCommand/LocalCommand/PermitLocalCommand can execute arbitrary code and is blocked. Remove the option." }
      ]
    },
    {
      "id": "ssh-allow-known-hosts",
      "tool": "Bash",
      "description": "Allow ssh to whitelisted machines. Host is matched in destination position after skipping -o/-x flags, so the alias can't be spoofed from inside a remote command. Edit the host alternation to add machines. Separated flag-args (-i FILE, -p PORT) are not skipped — use -oOpt=val forms or they fall through to a prompt.",
      "pipeline": [
        { "stage": "command-regex", "patterns": ["^ssh\\s+((-o\\s*\\S+|-[A-Za-z]\\S*)\\s+)*([a-z_][a-z0-9_.-]*@)?(nas|ovh|flatbox|stick|opn|claude-dev|claude-host|mac-work|nas-avanti)(\\s|$)"] },
        { "stage": "allow" }
      ]
    },
    {
      "id": "subshell-allow",
      "tool": "Bash",
      "description": "Allow subshells when all parts are permitted",
      "pipeline": [
        { "stage": "has-subshell" },
        { "stage": "all-parts-allowed", "prefixes": ["cd ", "skill ", "curl ", "git ", "kubectl ", "docker ", "jq ", "yq ", "cat ", "head ", "tail ", "grep ", "find ", "ls ", "tree ", "mkdir ", "cp ", "xargs ", "go ", "npm ", "python ", "ruff ", "golangci-lint ", "gcloud ", "ansible ", "a11s ", "./bin/a11s ", "hilo ", "mcpl ", "claude-hook-engine ", "echo ", "bun ", "semgrep "] }
      ]
    }
  ],
  "post": []
}
